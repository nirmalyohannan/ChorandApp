<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_surface"
    android:padding="20dp">

    <!-- Grab Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/text_tertiary"
        android:backgroundTint="@color/text_tertiary"
        android:layout_marginBottom="16dp" />

    <!-- Header Row: Method + Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvDetailMethod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/accent_cyan"
            android:background="@drawable/bg_method_pill"
            android:layout_marginEnd="8dp"
            tools:text="GET" />

        <TextView
            android:id="@+id/tvDetailStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            tools:text="200 OK"
            tools:textColor="@color/success" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyUrl"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Copy URL"
            android:textSize="11sp"
            android:textColor="@color/accent_blue"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_link"
            app:iconSize="14dp"
            app:iconTint="@color/accent_blue" />
    </LinearLayout>

    <!-- URL Text -->
    <TextView
        android:id="@+id/tvDetailUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="16dp"
        tools:text="https://api.github.com/users/octocat" />

    <!-- Metadata Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_default"
        android:layout_marginBottom="12dp" />

    <!-- Quick Metadata Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INITIATOR"
                android:textSize="10sp"
                android:textColor="@color/text_tertiary"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/tvDetailInitiator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif"
                android:layout_marginTop="2dp"
                tools:text="FETCH" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DURATION"
                android:textSize="10sp"
                android:textColor="@color/text_tertiary"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/tvDetailDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif"
                android:layout_marginTop="2dp"
                tools:text="142 ms" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIME"
                android:textSize="10sp"
                android:textColor="@color/text_tertiary"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/tvDetailTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif"
                android:layout_marginTop="2dp"
                tools:text="17:23:45.123" />
        </LinearLayout>

    </LinearLayout>

    <!-- Tab Switcher -->
    <LinearLayout
        android:id="@+id/tabSelector"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_stat_card"
        android:padding="3dp"
        android:layout_marginBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabHeaders"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Headers"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/bg_elevated"
            app:cornerRadius="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabRequest"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Request"
            android:textColor="@color/text_secondary"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabResponse"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Response"
            android:textColor="@color/text_secondary"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- Scrollable content area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="280dp">

        <!-- Headers ScrollView -->
        <ScrollView
            android:id="@+id/layoutHeaders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REQUEST HEADERS"
                    android:textSize="10sp"
                    android:textColor="@color/accent_blue"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvRequestHeaders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="16dp"
                    tools:text="Accept: application/json\nContent-Type: application/json" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RESPONSE HEADERS"
                    android:textSize="10sp"
                    android:textColor="@color/accent_cyan"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvResponseHeaders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="monospace"
                    tools:text="Cache-Control: no-cache\nServer: GitHub" />

            </LinearLayout>
        </ScrollView>

        <!-- Request Payload ScrollView -->
        <ScrollView
            android:id="@+id/layoutRequest"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REQUEST BODY"
                        android:textSize="10sp"
                        android:textColor="@color/accent_blue"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.1" />

                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyRequest"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Copy"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRequestBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="monospace"
                    tools:text="{}" />

            </LinearLayout>
        </ScrollView>

        <!-- Response Body ScrollView -->
        <ScrollView
            android:id="@+id/layoutResponse"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RESPONSE BODY / DETAILS"
                        android:textSize="10sp"
                        android:textColor="@color/accent_cyan"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.1" />

                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyResponse"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Copy"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvResponseBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="monospace"
                    tools:text="{}" />

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- Bottom Actions Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_default"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <!-- Copy Raw Event Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCopyRaw"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="COPY RAW EVENT JSON"
        android:textSize="12sp"
        android:letterSpacing="0.08"
        android:fontFamily="sans-serif-medium"
        app:backgroundTint="@color/bg_elevated"
        app:strokeColor="@color/border_default"
        app:strokeWidth="1dp"
        android:textColor="@color/text_primary"
        app:cornerRadius="12dp" />

</LinearLayout>
