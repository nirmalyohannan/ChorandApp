<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_default"
    app:strokeWidth="1dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top row: Type badge + Method + Status + Duration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <!-- Type badge -->
            <TextView
                android:id="@+id/tvType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textSize="9sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_badge"
                android:layout_marginEnd="8dp"
                tools:text="RESPONSE"
                tools:backgroundTint="@color/success" />

            <!-- Method pill -->
            <TextView
                android:id="@+id/tvMethod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textSize="9sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/accent_cyan"
                android:background="@drawable/bg_method_pill"
                android:layout_marginEnd="8dp"
                tools:text="GET" />

            <!-- Initiator (XHR / FETCH) -->
            <TextView
                android:id="@+id/tvInitiator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:textSize="8sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_tertiary"
                android:background="@drawable/bg_method_pill"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                tools:text="XHR"
                tools:visibility="visible" />

            <!-- Spacer -->
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <!-- Status code -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                tools:text="200"
                tools:textColor="@color/success"
                tools:visibility="visible" />

            <!-- Duration -->
            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/text_tertiary"
                android:fontFamily="sans-serif"
                android:visibility="gone"
                tools:text="142ms"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- URL -->
        <TextView
            android:id="@+id/tvUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="4dp"
            tools:text="https://api.example.com/v1/users/profile" />

        <!-- Timestamp -->
        <TextView
            android:id="@+id/tvTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@color/text_tertiary"
            android:fontFamily="sans-serif"
            tools:text="10:23:45.123" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
